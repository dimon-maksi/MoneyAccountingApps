@model IEnumerable<MoneyAccountingAppADONET.Models.Expense>

<h2>Expense</h2>

<p>
    <a class="btn btn-primary" asp-controller="Expense" asp-action="Create">Add New Expense</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Sum</th>
            <th>Date</th>
            <th>AccountId</th>
            <th>CategoryId</th>
            <th>Type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Sum</td>
                <td>@item.Date</td>
                <td>@item.AccountId</td>
                <td>@item.CategoryId</td>
                <td>@item.Type</td>
                <td>
                    <form asp-action="Delete" method="post" asp-controller="Expense">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
