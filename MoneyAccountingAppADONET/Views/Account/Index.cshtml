@model IEnumerable<MoneyAccountingAppADONET.Models.Account>

<h2>Account</h2>

<p>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Create">Add New Account</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Balance</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Balance</td>
                <td>
                    <form asp-action="Delete" method="post" asp-controller="Account">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
