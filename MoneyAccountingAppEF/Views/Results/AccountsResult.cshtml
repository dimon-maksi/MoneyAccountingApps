@model IEnumerable<MoneyAccountingAppEF.Models.Account>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Balance</th>
            <th>Total Expenses</th>
            <th>Total Incomes</th>
            <th>Total Savings</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model)
        {
            <tr>
                <td>@account.Name</td>
                <td>@account.Balance</td>
                <td>@account.Expenses.Sum(e => e.Sum)</td>
                <td>@account.Incomes.Sum(i => i.Sum)</td>
                <td>@account.Savings.Sum(s => s.Sum)</td>
            </tr>
        }
    </tbody>
</table>
